<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="12dp">

    <!-- Icono superior (Rayo o Alerta) -->
    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@android:drawable/ic_dialog_info"
        app:tint="#3B82F6"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Texto de Nuevo Pedido -->
    <TextView
        android:id="@+id/tvNewOrder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NUEVO PEDIDO"
        android:textColor="#3B82F6"
        android:textSize="10sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivIcon" />

    <!-- Folio del Pedido -->
    <TextView
        android:id="@+id/tvOrderNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="#1024"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvNewOrder" />

    <!-- Botón de Preparar -->
    <Button
        android:id="@+id/btnPreparar"
        android:layout_width="wrap_content"
        android:layout_height="35dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#10B981"
        android:text="PREPARAR"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvOrderNumber" />

    <!-- Texto de Descartar -->
    <TextView
        android:id="@+id/tvDescartar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Descartar"
        android:textColor="#94A3B8"
        android:textSize="10sp"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnPreparar" />

</androidx.constraintlayout.widget.ConstraintLayout>